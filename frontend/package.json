{
  "name": "region-resources-checker-gui",
  "version": "1.0.0",
  "description": "GUI for Azure Region Resource Provider Checker",
  "scripts": {
    "dev": "vite",
    "dev:server": "npx ts-node server/index.ts",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node server-dist/index.js",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "express": "^4.21.0",
    "@azure/identity": "^4.5.0",
    "@azure/storage-blob": "^12.26.0"
  },
  "devDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.17.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0"
  }
}
